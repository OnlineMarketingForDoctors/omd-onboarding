# Private Integration token for the sub-account (Settings > Private Integrations).
# Scopes: contacts.readonly, contacts.write, locations/customFields.readonly
GHL_TOKEN=
# The sub-account (location) id the contacts live in.
GHL_LOCATION_ID=
# The workflow to add the contact to after a successful update.
# Its id is the last part of the URL when you open the workflow in GHL.
GHL_WORKFLOW_ID=
# Shared password the team types to use the tool. Leave empty only for local use.
ACCESS_PASSWORD=
